# ============================================================
# 车险出单智能体 — 根级 .gitignore
# 覆盖 Java / 前端(Node) / Python 三类技术栈
# 原则:忽略 IDE 配置、编译产物、依赖目录、虚拟环境、环境变量与密钥
#       但保留 .env.example 等配置模板
# ============================================================

# ---------- macOS ----------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.history/
*.swp
*.swo
*~

# ---------- Java / Maven ----------
target/
build/
out/
bin/
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*
replay_pid*
.gradle/
# Maven Wrapper 的 jar 需要入库,单独保留
!**/.mvn/wrapper/maven-wrapper.jar

# ---------- Node / 前端 ----------
node_modules/
dist/
dist-ssr/
.netlify/
.vercel/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm-cache/
.build-tmp/
*.tmpdir
# 锁文件必须入库(保证依赖版本一致),不忽略 package-lock.json / pnpm-lock.yaml

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
*.sqlite3
*.db

# ---------- 环境变量与密钥 ----------
.env
.env.*
!.env.example
!*.env.example
!*.env.template
application-local.yml
application-local-*.yml
application-secret.yml
application-*-secret.yml
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/
secret/

# ---------- 运行时产物 ----------
logs/
log/
uploads/
tmp/
temp/
*.pid
*.seed
